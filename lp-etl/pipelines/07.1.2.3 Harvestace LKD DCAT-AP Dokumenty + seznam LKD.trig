<http://localhost:8080/resources/pipelines/1779171546131-0003/component/3477-8695/configuration> {
  <http://localhost:8080/resources/pipelines/1779171546131-0003/component/3477-8695/configuration>
    a <http://plugins.linkedpipes.com/ontology/x-pipeline#Configuration>;
    <http://plugins.linkedpipes.com/ontology/x-pipeline#deleteWorkingData> false;
    <http://plugins.linkedpipes.com/ontology/x-pipeline#deleteWorkingDataControl> <http://plugins.linkedpipes.com/resource/configuration/Inherit>;
    <http://plugins.linkedpipes.com/ontology/x-pipeline#instance> <http://localhost:8080>;
    <http://plugins.linkedpipes.com/ontology/x-pipeline#instanceControl> <http://plugins.linkedpipes.com/resource/configuration/Inherit>;
    <http://plugins.linkedpipes.com/ontology/x-pipeline#logLevel> "INFO";
