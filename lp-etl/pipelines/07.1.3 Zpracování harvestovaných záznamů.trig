<http://localhost:8080/resources/pipelines/1779114807953-0003/component/8e5f-a45c/configuration> {
  <http://localhost:8080/resources/pipelines/1779114807953-0003/component/8e5f-a45c/configuration>
    a <http://plugins.linkedpipes.com/ontology/t-sparqlUpdateChunked#Configuration>;
    <http://plugins.linkedpipes.com/ontology/t-sparqlUpdateChunked#query> """PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dcatap: <http://data.europa.eu/r5r/>
PREFIX accessRights: <http://publications.europa.eu/resource/authority/access-right/>
PREFIX DGA: <http://data.europa.eu/eli/reg/2022/868/oj>
PREFIX l365: <https://www.e-sbirka.cz/eli/cz/sb/2000/365/2024-01-20>
PREFIX l360: <https://www.e-sbirka.cz/sb/2023/360/2024-07-01>
PREFIX nsip: <https://data.gov.cz/zdroj/katalog/NSIP>

INSERT {
  nsip: dcat:dataset ?dataset .
  
  ?dataset dcatap:applicableLegislation DGA: ;
    dcterms:accessRights accessRights:NON_PUBLIC .
  
  ?distribution dcatap:applicableLegislation DGA: .
  ?service dcatap:applicableLegislation DGA: .
} 
WHERE {
  ?dataset a ?type .
  VALUES ?type { dcat:Dataset dcat:DatasetSeries }
  ?dataset dcatap:applicableLegislation l365:, l360: .
  
  OPTIONAL {
   ?dataset dcat:distribution ?distribution .
   ?distribution dcatap:applicableLegislation l365:, l360: .
    
   OPTIONAL {?distribution dcat:accessService ?service .
      ?service dcatap:applicableLegislation l365:, l360: .
   }
  }
}""";
    <http://plugins.linkedpipes.com/ontology/t-sparqlUpdateChunked#queryControl> <http://plugins.linkedpipes.com/resource/configuration/None>;
    <http://plugins.linkedpipes.com/ontology/t-sparqlUpdateChunked#softFail> false;
    <http://plugins.linkedpipes.com/ontology/t-sparqlUpdateChunked#softFailControl> <http://plugins.linkedpipes.com/resource/configuration/None>;
    <http://plugins.linkedpipes.com/ontology/t-sparqlUpdateChunked#threads> 4;
    <http://plugins.linkedpipes.com/ontology/t-sparqlUpdateChunked#threadsControl> <http://plugins.linkedpipes.com/resource/configuration/None> .
}

