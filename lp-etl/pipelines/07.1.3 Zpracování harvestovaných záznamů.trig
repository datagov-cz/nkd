<http://localhost:8080/resources/pipelines/1779114807953-00031779114807953-000316110389317791764943595711-0001985d-a5ec/configuration> {
  <http://localhost:8080/resources/pipelines/1779114807953-00031779114807953-000316110389317791764943595711-0001985d-a5ec/configuration>
    a <http://plugins.linkedpipes.com/ontology/t-sparqlUpdateChunked#Configuration>;
    <http://plugins.linkedpipes.com/ontology/t-sparqlUpdateChunked#query> """PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX adms: <http://www.w3.org/ns/adms#>
PREFIX dcat: <http://www.w3.org/ns/dcat#>

INSERT { 
  ?service adms:identifier ?Identifier.
  
  ?Identifier a adms:Identifier ;
    skos:notation ?identifier ;
    dcterms:creator ?Publisher .
}
WHERE 
{
  ?service a dcat:DataService ;
    dcterms:identifier ?identifier ;
    ^dcat:accessService/^dcat:distribution/dcterms:publisher ?Publisher.

  BIND(STR(?service) AS ?strService)
  BIND(IRI(CONCAT(?strService, \"/identifikátorLKOD\")) AS ?Identifier)
}""";
    <http://plugins.linkedpipes.com/ontology/t-sparqlUpdateChunked#queryControl> <http://plugins.linkedpipes.com/resource/configuration/None>;
