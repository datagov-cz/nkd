    <http://plugins.linkedpipes.com/ontology/e-sparqlEndpoint#query> """PREFIX pojmy: <https://slovník.gov.cz/legislativní/sbírka/111/2009/pojem/>
PREFIX a104: <https://slovník.gov.cz/agendový/104/pojem/>
PREFIX nkod: <https://data.gov.cz/slovník/nkod/>

CONSTRUCT {
  ?ds nkod:původce-dat ?ovm .
}
WHERE {
#  ?os a a104:objekt-nebo-subjekt-údajů ;
#      a104:má-údaj ?údaj ;
#      a104:sdružuje-údaje-vedené-nebo-vytvářené-v-rámci-agendy ?agenda .
#
#  ?ovm a pojmy:orgán-veřejné-moci ;
#      pojmy:ohlašuje-agendu ?agenda .
#
#  ?agenda a pojmy:Agenda .
#
#  ?údaj a pojmy:údaj ;
#      pojmy:iri-datové-sady-publikující-veřejný-údaj ?ds .
#  
  ?ds ^pojmy:iri-datové-sady-publikující-veřejný-údaj/^a104:má-údaj/a104:sdružuje-údaje-vedené-nebo-vytvářené-v-rámci-agendy/^pojmy:ohlašuje-agendu ?ovm .
}""";
