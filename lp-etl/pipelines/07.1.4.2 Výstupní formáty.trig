                \"dc:description\": \"IRI periodicity aktualizace datové sady.\",
                \"datatype\": \"anyURI\"
            },
            {
                \"titles\": \"periodicita_aktualizace\",
                \"dc:description\": \"Název periodicity aktualizace datové sady.\",
                \"datatype\": \"string\"
            },
            {
                \"titles\": \"je_součástí_IRI\",
                \"dc:description\": \"IRI datové série, jíž je datová sada součástí.\",
                \"datatype\": \"anyURI\"
            },
            {
                \"titles\": \"isvs\",
                \"dc:description\": \"IRI informačního systému veřejné správy, který datovou sadu zahrnuje.\",
                \"datatype\": \"anyURI\"
            }
        ]
    }
}""";
