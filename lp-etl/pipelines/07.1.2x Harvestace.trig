}

<http://localhost:8080/resources/pipelines/1779112574119-00021779112574119-00021779112327880-00011779112327880-000116110389317791764943595711-0001161103893177916110389317791611038931779140/configuration> {
  <http://localhost:8080/resources/pipelines/1779112574119-00021779112574119-00021779112327880-00011779112327880-000116110389317791764943595711-0001161103893177916110389317791611038931779140/1>
