    <http://plugins.linkedpipes.com/ontology/e-httpGetFiles#encodeUrl> true;
    <http://plugins.linkedpipes.com/ontology/e-httpGetFiles#encodeUrlControl> <http://plugins.linkedpipes.com/resource/configuration/None>;
