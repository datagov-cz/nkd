<http://localhost:8080/resources/pipelines/1779171403535-00021779171403535-00021779112574119-00021779112574119-00021779112327880-00011779112327880-000116110389317791764943595711-0001161103893177916110389317791611038931779121/configuration> {
  <http://localhost:8080/resources/pipelines/1779171403535-00021779171403535-00021779112574119-00021779112574119-00021779112327880-00011779112327880-000116110389317791764943595711-0001161103893177916110389317791611038931779121/1>
    a <http://plugins.linkedpipes.com/ontology/t-sparqlConstruct#Configuration>;
    <http://plugins.linkedpipes.com/ontology/t-sparqlConstruct#query> """PREFIX localhost: <http://localhost/>
PREFIX ss: <http://plugins.linkedpipes.com/ontology/t-sparqlSelectMultiple#> 
PREFIX loc: <http://www.w3.org/2007/uwa/context/location.owl#>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX dcat: <http://www.w3.org/ns/dcat#>

CONSTRUCT { 
?configiri a ss:Configuration ;
    ss:query ?query ;
    ss:fileName ?filename .
} 
WHERE 
{ 
  {SELECT DISTINCT ?catalog WHERE {?catalog dcat:dataset [] . }}

BIND(CONCAT(\"\"\"
PREFIX dcat: <http://www.w3.org/ns/dcat#>
SELECT ?dataset
WHERE {
<\"\"\",STR(?catalog),\"\"\"> dcat:dataset ?dataset .
}
\"\"\") as ?query)

BIND(CONCAT(REPLACE(STR(?catalog),\"[:/\\\\.]\",\"_\"),\".csv\") as ?filename)
BIND(UUID() as ?configiri)
}""";
