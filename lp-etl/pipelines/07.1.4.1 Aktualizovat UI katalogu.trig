  <http://localhost:8080/resources/pipelines/1779171935944-00051779171935944-00051779116262165-00041779116262165-000416110389317791764943595711-0001161103893177916110389317791611038931779143/configuration>
    a <http://plugins.linkedpipes.com/ontology/t-sparqlConstruct#Configuration>;
    <http://plugins.linkedpipes.com/ontology/t-sparqlConstruct#query> """PREFIX local:   <http://localhost/temp/>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>

CONSTRUCT {
<http://localhost/resource/root> a local:Root;
   <http://plugins.linkedpipes.com/ontology/t-mustache#fileName> \"filter.json\" ;
   local:themes ?theme.
?theme local:cs ?csstring.
?theme local:en ?enstring.
}
WHERE {

?theme skos:prefLabel ?cs_label, ?en_label .
    
FILTER(langMatches(LANG(?cs_label), \"cs\"))
FILTER(langMatches(LANG(?en_label), \"en\"))

BIND(STR(?cs_label) as ?csstring)
BIND(STR(?en_label) as ?enstring)
}""";
    <http://plugins.linkedpipes.com/ontology/t-sparqlConstruct#queryControl> <http://plugins.linkedpipes.com/resource/configuration/None> .
}

<http://localhost:8080/resources/pipelines/1779171935944-00051779171935944-00051779116262165-00041779116262165-000416110389317791764943595711-00011611038931779161103893177916110389317791434-867c/configuration> {
  <http://localhost:8080/resources/pipelines/1779171935944-00051779171935944-00051779116262165-00041779116262165-000416110389317791764943595711-00011611038931779161103893177916110389317791434-867c/1>
    a <http://plugins.linkedpipes.com/ontology/t-sparqlConstruct#Configuration>;
    <http://plugins.linkedpipes.com/ontology/t-sparqlConstruct#query> """PREFIX gr: <http://purl.org/goodrelations/v1#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX dcat:       <http://www.w3.org/ns/dcat#>
PREFIX rdf:          <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX local:       <http://localhost/temp/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

CONSTRUCT {
<http://localhost/resource/root> a local:Root;
   <http://plugins.linkedpipes.com/ontology/t-mustache#fileName> \"filter.json\" ;
   local:publishers ?publisher .

  ?publisher local:cs ?csstring.
  ?publisher local:en ?enstring.
  
}
WHERE {
  ?catalog dcterms:publisher ?publisher .
  
  OPTIONAL {
    ?publisher gr:legalName ?cs_label .
    FILTER(langMatches(LANG(?cs_label), \"cs\"))
    BIND(STR(?cs_label) as ?csstring)
  }
  
  OPTIONAL {
    ?publisher gr:legalName ?en_label .
    FILTER(langMatches(LANG(?en_label), \"en\"))
    BIND(STR(?en_label) as ?enstring)
  }
  
}""";
    <http://plugins.linkedpipes.com/ontology/t-sparqlConstruct#queryControl> <http://plugins.linkedpipes.com/resource/configuration/None> .
}

<http://localhost:8080/resources/pipelines/1779171935944-00051779171935944-00051779116262165-00041779116262165-000416110389317791764943595711-0001161103893177916110389317791611038931779145/configuration> {
