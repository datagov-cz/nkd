<http://localhost:8080/resources/pipelines/1779116262165-00041779116262165-000416110389317791764943595711-0001161103893177916110389317791611038931779432/configuration> {
  <http://localhost:8080/resources/pipelines/1779116262165-00041779116262165-000416110389317791764943595711-0001161103893177916110389317791611038931779432/1>
    a <http://plugins.linkedpipes.com/ontology/t-sparqlUpdate#Configuration>;
    <http://plugins.linkedpipes.com/ontology/t-sparqlUpdate#query> """PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dcterms: <http://purl.org/dc/terms/>

PREFIX mustache: <http://plugins.linkedpipes.com/ontology/t-mustache#>
PREFIX temp: <urn:>

INSERT {
  ?dataset temp:title_en_sort ?title_cs
}
WHERE {
  ?dataset temp:title_cs ?title_cs .
  FILTER NOT EXISTS {
    ?dataset temp:title_en ?en
  }
}""";
    <http://plugins.linkedpipes.com/ontology/t-sparqlUpdate#queryControl> <http://plugins.linkedpipes.com/resource/configuration/None> .
}

<http://localhost:8080/resources/pipelines/1779116262165-00041779116262165-000416110389317791764943595711-0001161103893177916110389317791611038931779443/configuration> {
  <http://localhost:8080/resources/pipelines/1779116262165-00041779116262165-000416110389317791764943595711-0001161103893177916110389317791611038931779443/1>
    a <http://plugins.linkedpipes.com/ontology/t-sparqlConstruct#Configuration>;
    <http://plugins.linkedpipes.com/ontology/t-sparqlConstruct#query> """PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX dcat:       <http://www.w3.org/ns/dcat#>
PREFIX rdf:          <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX local:       <http://localhost/temp/>

CONSTRUCT {
<http://localhost/resource/root> a local:Root;
   <http://plugins.linkedpipes.com/ontology/t-mustache#fileName> \"publisher_keywords_cs.json\" ;
   local:entry ?entryID.
?entryID a local:Entry ;
   rdf:value ?počet_poskytovatelů ;
   <urn:keyword> ?kwstring ;
   <urn:keyword_lang> ?lang .
}
WHERE {
{
SELECT ?keyword (count (distinct ?poskytovatel ) as ?počet_poskytovatelů)
WHERE 
{
?datova_sada a dcat:Dataset ; 
    dcterms:publisher ?poskytovatel ;
    ^dcat:dataset <https://data.gov.cz/zdroj/katalog/NKOD> ;
    dcat:keyword ?keyword .
}
GROUP BY ?keyword
#HAVING (?počet_poskytovatelů > 1)
}
  BIND(IRI(CONCAT(\"http://localhost/temp/\", LANG(?keyword), \"/\", ENCODE_FOR_URI(STR(?keyword)))) as ?entryID)
  BIND(STR(?keyword) as ?kwstring)
  BIND(LANG(?keyword) as ?lang)
  FILTER(LANG(?keyword) = \"cs\")
}""";
    <http://plugins.linkedpipes.com/ontology/t-sparqlConstruct#queryControl> <http://plugins.linkedpipes.com/resource/configuration/None> .
}

