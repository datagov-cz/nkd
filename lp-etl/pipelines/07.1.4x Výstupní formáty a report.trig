    <http://plugins.linkedpipes.com/ontology/t-mustache#template> """{{!
PREFIX dcterms: <http://purl.org/dc/terms/> 
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dcatap: <http://data.europa.eu/r5r/>
PREFIX mustache: <http://plugins.linkedpipes.com/ontology/t-mustache#>
PREFIX temp: <urn:>
}}

[
{{#temp:dataset}}
{{^mustache:first}},{{/mustache:first}}
{
    \"iri\": \"{{{@id}}}\",
    \"title_cs\" : \"{{{temp:title_cs}}}\",
    \"title_en\" : \"{{{temp:title_en}}}\",
    \"title_cs_sort\" : \"{{{temp:title_cs_sort}}}\",
    \"title_en_sort\" : \"{{{temp:title_en_sort}}}\",
    \"description_cs\" : \"{{{temp:description_cs}}}\",
    \"description_en\" : \"{{{temp:description_en}}}\",
    \"accrual_periodicity\" : \"{{temp:accrualPeriodicity}}\",
    \"publisher\" : \"{{{temp:publisher}}}\",
